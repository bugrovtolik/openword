CREATE TABLE commentaries (
    book_number INTEGER,
    chapter INTEGER,
    verse_start INTEGER,
    verse_end INTEGER,
    text TEXT,
    marker TEXT
);

CREATE INDEX bookChapterVerseIndex ON commentaries (book_number, chapter, verse_start);

getCommentariesForVerse:
SELECT book_number, chapter, verse_start, verse_end, text
FROM commentaries
WHERE book_number = ? AND chapter = ? AND verse_start <= ? AND verse_end >= ?;

getCommentaryByMarker:
SELECT text
FROM commentaries
WHERE book_number = ? AND chapter = ? AND verse_start = ? AND (marker = ? OR marker = ?);